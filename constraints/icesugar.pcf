# ==========================================
# iCESugar v1.5 (iCE40UP5K-SG48)
# Pin untuk top level fpga/top_icesugar.v
# ==========================================

# Clock on-board 12 MHz
set_io clk 35

# DIP switch on-board (berbagi pin dengan PMOD 4)
set_io SW[0] 18
set_io SW[1] 19
set_io SW[2] 20
set_io SW[3] 21

# LED RGB on-board, aktif rendah
set_io LED_R 40
set_io LED_G 41
set_io LED_B 39

# ------------------------------------------
# Cadangan untuk TM1638 di PMOD 1 (belum dipakai)
# ------------------------------------------
# set_io tm_cs  9
# set_io tm_clk 4
# set_io tm_dio 2
