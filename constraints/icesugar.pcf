# ==========================================
# iCESugar v1.5 (iCE40UP5K-SG48)
# Pin untuk top level fpga/top_icesugar.v
# ==========================================

# Clock on-board 12 MHz
set_io clk 35

# DIP switch on-board (berbagi pin dengan PMOD 4)
set_io SW[0] 18
set_io SW[1] 19
set_io SW[2] 20
set_io SW[3] 21

# LED RGB on-board, aktif rendah
set_io LED_R 40
set_io LED_G 41
set_io LED_B 39

# ------------------------------------------
# UART iCELink (USB), dipakai loader dan bootloader
# ------------------------------------------
set_io uart_rx 4
set_io uart_tx 6

# ------------------------------------------
# TM1638 di PMOD 2 lewat SPI universal.
# Posisi pin sama dengan PMOD 1 saat UTS (pin 10, 11, 12 PMOD),
# karena pin 4 (PMOD 1 pin 11) dipakai UART RX iCELink.
#   STB -> P2_12 = 45, CLK -> P2_11 = 43, DIO -> P2_10 = 38
# ------------------------------------------
set_io tm_stb 45
set_io tm_clk 43
set_io tm_dio 38
